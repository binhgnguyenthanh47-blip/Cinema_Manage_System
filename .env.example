# Sao chep file nay thanh .env (cung thu muc) roi sua theo MySQL cua ban.
# Khong co file .env thi he thong dung mac dinh XAMPP: root / khong mat khau.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=cinema_management_dev
DB_USER=root
DB_PASSWORD=

# 1 = hien chi tiet loi SQL trong API (chi bat khi dang phat trien)
APP_DEBUG=0
